# PayPal Developer Dashboard -> Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Alibaba Cloud Model Studio (Bailian / DashScope) API key; or put it in ~/.config/dashscope_key
DASHSCOPE_API_KEY=
# Optional
# QWEN_MODEL=qwen3.8-flash
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Hosted demo mode (optional; e.g. on Render). PUBLIC_URL defaults to Render's RENDER_EXTERNAL_URL.
# PUBLIC_URL=https://your-app.onrender.com
# DEMO_ACCESS_CODE=at-least-6-characters
# SANDBOX_BUYER_EMAIL=     # shown to logged-in visitors so they can pay as the sandbox buyer
# SANDBOX_BUYER_PASSWORD=
